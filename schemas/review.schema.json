{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ncukondo/search-hub/schemas/review.schema.json",
  "title": "Review File",
  "description": "Schema for article review workflow tracking",
  "type": "object",
  "required": ["sessionId", "articles"],
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "Session identifier"
    },
    "criteria": {
      "type": "string",
      "description": "Path to inclusion criteria file"
    },
    "reviewer": {
      "type": "string",
      "description": "Reviewer identifier (only in extracted ReviewFiles)"
    },
    "articles": {
      "type": "array",
      "description": "List of articles with review data",
      "items": {
        "$ref": "#/definitions/ArticleEntry"
      }
    },
    "reviewers": {
      "type": "array",
      "description": "Registry of reviewers who participated at each basis level",
      "items": {
        "$ref": "#/definitions/ReviewerRecord"
      }
    }
  },
  "definitions": {
    "ReviewerRecord": {
      "type": "object",
      "description": "Record of a reviewer's participation at a specific basis level",
      "required": ["name", "basis"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Reviewer identifier"
        },
        "basis": {
          "type": "string",
          "enum": ["title", "abstract", "fulltext"],
          "description": "Basis level at which the reviewer participated"
        }
      },
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "description": "Individual assessment of an article",
      "required": ["reviewer"],
      "properties": {
        "reviewer": {
          "type": "string",
          "description": "Reviewer identifier (e.g., 'gpt-4o', 'claude-sonnet', 'human:tanaka')"
        },
        "decision": {
          "type": "string",
          "enum": ["include", "exclude", "uncertain"],
          "description": "Assessment decision"
        },
        "basis": {
          "type": "string",
          "enum": ["title", "abstract", "fulltext"],
          "description": "Basis of the decision (what information was used)"
        },
        "comment": {
          "type": "string",
          "description": "Optional comment or reason"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        }
      },
      "additionalProperties": false
    },
    "MergedSource": {
      "type": "object",
      "description": "Source information for merged duplicates",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Database source (e.g., 'pubmed', 'scopus')"
        },
        "pmid": { "type": "string" },
        "doi": { "type": "string" },
        "scopusId": { "type": "string" },
        "arxivId": { "type": "string" },
        "ericId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ArticleEntry": {
      "type": "object",
      "description": "Article with identifiers, bibliographic info, and reviews",
      "required": ["title", "reviews"],
      "properties": {
        "doi": {
          "type": "string",
          "description": "Digital Object Identifier"
        },
        "pmid": {
          "type": "string",
          "description": "PubMed ID"
        },
        "scopusId": {
          "type": "string",
          "description": "Scopus ID"
        },
        "arxivId": {
          "type": "string",
          "description": "arXiv ID"
        },
        "ericId": {
          "type": "string",
          "description": "ERIC ID"
        },
        "title": {
          "type": "string",
          "description": "Article title"
        },
        "authors": {
          "type": "string",
          "description": "Authors (formatted string)"
        },
        "year": {
          "type": "string",
          "description": "Publication year"
        },
        "abstract": {
          "type": "string",
          "description": "Article abstract"
        },
        "mergedFrom": {
          "type": "array",
          "description": "Sources this article was merged from during deduplication",
          "items": {
            "$ref": "#/definitions/MergedSource"
          }
        },
        "reviews": {
          "type": "array",
          "description": "List of assessments",
          "items": {
            "$ref": "#/definitions/Review"
          }
        },
        "reviewHistory": {
          "type": "array",
          "description": "Historical reviews (only in extracted ReviewFiles, never in master file)",
          "items": {
            "$ref": "#/definitions/Review"
          }
        },
        "finalDecision": {
          "type": ["string", "null"],
          "enum": ["include", "exclude", null],
          "description": "Final inclusion/exclusion decision (null in extracted files)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
