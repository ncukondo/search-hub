{
  "name": "@ncukondo/search-hub",
  "version": "0.11.0",
  "description": "A CLI tool for systematic literature searching across multiple academic databases",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "search-hub": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncukondo/search-hub.git"
  },
  "bugs": {
    "url": "https://github.com/ncukondo/search-hub/issues"
  },
  "homepage": "https://github.com/ncukondo/search-hub#readme",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --project unit",
    "test:unit": "vitest --project unit",
    "test:e2e": "vitest --project e2e",
    "test:all": "vitest",
    "test:coverage": "vitest --project unit --coverage",
    "test:e2e:coverage": "vitest --project e2e --coverage",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json --fix .",
    "format": "oxfmt --write src",
    "format:check": "oxfmt src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "test:api": "vitest --project api",
    "test:ci": "vitest --project unit --project e2e"
  },
  "keywords": [
    "systematic-review",
    "literature-search",
    "pubmed",
    "scopus",
    "arxiv",
    "eric",
    "academic",
    "research",
    "cli"
  ],
  "author": "ncukondo",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "any-ascii": "^0.3.3",
    "cli-progress": "^3.12.0",
    "commander": "^13.0.0",
    "dotenv": "^17.2.3",
    "env-paths": "^3.0.0",
    "fast-xml-parser": "^5.3.3",
    "ora": "^8.1.1",
    "yaml": "^2.6.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.2"
  }
}
