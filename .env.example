# =============================================================================
# Search Hub - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PubMed (NCBI E-utilities)
# -----------------------------------------------------------------------------
# API key is optional but recommended for higher rate limits
# Without key: 3 requests/second
# With key: 10 requests/second
# Get your key at: https://www.ncbi.nlm.nih.gov/account/settings/
SEARCH_HUB_PUBMED_API_KEY=

# Email is required by NCBI for API usage (their policy)
SEARCH_HUB_PUBMED_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# Scopus (Elsevier)
# -----------------------------------------------------------------------------
# API key is required (needs institutional subscription)
# Get your key at: https://dev.elsevier.com/
SEARCH_HUB_SCOPUS_API_KEY=

# Institutional token is optional (for higher rate limits)
SEARCH_HUB_SCOPUS_INST_TOKEN=

# -----------------------------------------------------------------------------
# ERIC
# -----------------------------------------------------------------------------
# No authentication required

# -----------------------------------------------------------------------------
# arXiv
# -----------------------------------------------------------------------------
# No authentication required
# Note: Strict rate limit of 1 request per 3 seconds is enforced by arXiv
